# ============================================================================
# Showcase configuration — copy to `.env` (which is git-ignored).
# The default backend is a deterministic MOCK model: no API key, no network,
# no cost. You do not need to fill anything in to run `make eval` or the demos.
# ============================================================================

# ---- LLM backend --------------------------------------------------------
# mock       (default) deterministic canned responses; offline; free; CI-safe
# ollama     local OpenAI-compatible endpoint (e.g. Ollama / LM Studio)
# openrouter real hosted models (requires a key)
MODEL_BACKEND=mock

# Only used when MODEL_BACKEND=openrouter
LLM_OPENROUTER_API_KEY=
OPENROUTER_REFERER=https://example.com
OPENROUTER_APP_TITLE=et-hotel-ai-showcase

# Only used when MODEL_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Langfuse (OPTIONAL, off by design) ---------------------------------
# Curated production prompts are managed in Langfuse and are intentionally
# WITHHELD from this repo. With Langfuse disabled (default), the pipeline
# falls back to the generic, illustrative prompts in prompts/baseline/.
# (Baseline prompts also load whenever the keys below are empty, as here.)
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
